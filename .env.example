# Postgres connection string. Works with Vercel Postgres, Neon, Supabase,
# or any managed Postgres provider — copy the connection string it gives you.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Random secret used to sign session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# The URL this app is served from. For local dev, leave as-is.
# In Vercel, set this to your deployment URL (e.g. https://your-app.vercel.app).
NEXTAUTH_URL="http://localhost:3000"

# Where the site lives, for links that leave it (reset emails, links an admin
# hands over). Defaults to https://eqal.rentals in production; never taken
# from the request. Only set this if the site moves.
# SITE_URL="https://eqal.rentals"

# Optional: lets "Forgot your password?" on the sign-in page email a reset link.
# Without these, an admin makes reset links by hand from the Admin page.
# Resend (resend.com) has a free tier; EMAIL_FROM must be on a domain you've
# verified there, e.g. "Rent Roll <no-reply@eqal.rentals>".
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Rent Roll <no-reply@example.com>"

# Signups are open by default: anyone can create an account and their own LLC.
# To make them invite-only, uncomment both lines; then this code, or a join
# code from an existing team, is needed to sign up.
# SIGNUPS="invite-only"
# SIGNUP_CODE="choose-a-code"

# Storage for receipts, repair photos and documents. Vercel sets these when
# you connect a Blob store from the project's Storage tab. Use a PRIVATE
# store: nothing in it opens without this token, and the app serves each
# file only to people signed in with access to it. If the private store's
# variable comes out under another name, rename it to this one.
# PRIVATE_BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
#
# The original public store, if you had one. New uploads go to the private
# store once it exists; Account → Stored files moves the old ones over.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
#
# Local testing only: keep files in this folder instead. Refused on Vercel.
# LOCAL_STORAGE_DIR="./.local-storage"
