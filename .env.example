# Postgres connection string. Works with Vercel Postgres, Neon, Supabase,
# or any managed Postgres provider — copy the connection string it gives you.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Random secret used to sign session tokens. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"

# The URL this app is served from. For local dev, leave as-is.
# In Vercel, set this to your deployment URL (e.g. https://your-app.vercel.app).
NEXTAUTH_URL="http://localhost:3000"

# Optional: require this code to create an account, so strangers who find
# the URL can't sign themselves up. Leave unset to allow open signup.
# SIGNUP_CODE="choose-a-code"

# Storage for proof photos and receipts. Vercel sets this for you when you add
# Blob from the project's Storage tab. Without it the app runs fine, but
# uploading proof fails with a message explaining how to turn it on.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
