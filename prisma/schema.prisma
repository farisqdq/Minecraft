generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  memberships          CompanyMember[]
  invitesSent          Invite[]           @relation("InviteSender")
  createdProperties    Property[]
  createdTransactions  Transaction[]
  uploadedAttachments  Attachment[]
  createdRecurring     RecurringExpense[]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members    CompanyMember[]
  properties Property[]
  invites    Invite[]
}

model CompanyMember {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String?
  role        String    @default("member")
  token       String    @unique
  invitedById String?
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  @@index([companyId])
  @@index([email])
}

model Property {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  name        String
  address     String?
  monthlyRent Float    @default(0)
  vacant      Boolean  @default(false)
  createdAt   DateTime @default(now())

  units             Unit[]
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]

  @@index([companyId])
}

// A single rental unit inside a property. Optional: most properties have
// none and are tracked directly, this only kicks in for a duplex/triplex/
// building where each unit needs its own rent target and tenant.
model Unit {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name        String
  monthlyRent Float    @default(0)
  vacant      Boolean  @default(false)
  createdAt   DateTime @default(now())

  transactions      Transaction[]
  recurringExpenses RecurringExpense[]

  @@index([propertyId])
}

model Transaction {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  type        String
  date        DateTime
  amount      Float
  detail      String?
  note        String?
  category    String?
  createdAt   DateTime @default(now())

  attachments        Attachment[]
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([unitId])
  @@index([recurringExpenseId])
}

// A template for a bill that repeats (mortgage, insurance, HOA). It never
// posts anything on its own — the dashboard surfaces it as due, and logging
// it is a one-click action that creates a normal Transaction tagged back to
// this template, so nothing lands in the ledger without a person seeing it.
model RecurringExpense {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  category    String
  detail      String?
  note        String?
  amount      Float
  frequency   String // "monthly" | "yearly"
  day         Int // day of month, 1-31 (clamped to the month's last day)
  month       Int? // 1-12, only used when frequency = "yearly"
  active      Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  transactions Transaction[]

  @@index([propertyId])
  @@index([unitId])
}

model Attachment {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  url           String
  pathname      String
  filename      String
  contentType   String
  size          Int
  uploadedById  String?
  uploadedBy    User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}
