generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  memberships         CompanyMember[]
  invitesSent         Invite[]           @relation("InviteSender")
  createdProperties   Property[]
  createdTransactions Transaction[]
  uploadedAttachments Attachment[]
  createdRecurring    RecurringExpense[]
  createdTenants      Tenant[]
  RentChange          RentChange[]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members    CompanyMember[]
  properties Property[]
  invites    Invite[]
}

model CompanyMember {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String?
  role        String    @default("member")
  token       String    @unique
  invitedById String?
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  @@index([companyId])
  @@index([email])
}

model Property {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  name        String
  address     String?
  monthlyRent Float    @default(0)
  vacant      Boolean  @default(false)
  createdAt   DateTime @default(now())

  units             Unit[]
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]
  tenants           Tenant[]
  rentChanges       RentChange[]

  @@index([companyId])
}

// A single rental unit inside a property. Optional: most properties have
// none and are tracked directly, this only kicks in for a duplex/triplex/
// building where each unit needs its own rent target and tenant.
model Unit {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name        String
  monthlyRent Float    @default(0)
  vacant      Boolean  @default(false)
  createdAt   DateTime @default(now())

  transactions      Transaction[]
  recurringExpenses RecurringExpense[]
  tenants           Tenant[]
  rentChanges       RentChange[]

  @@index([propertyId])
}

// Who is renting a place, and on what terms. Lease details live here rather
// than in a separate Lease model because a small landlord thinks in terms of
// "who's in the house right now" — a tenant who moves out is kept with
// active = false so their history and their old ledger entries still make
// sense, and the next tenant is a new row.
// What a place rented for, and from when. Without this, raising the rent
// would re-judge every month already on the books against the new figure —
// a year of correctly paid rent would suddenly read as short. A row is
// written whenever the rent changes; months before the earliest row fall
// back to whatever the property or unit currently says.
model RentChange {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId        String?
  unit          Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // Always the first day of the month the amount takes effect.
  effectiveFrom DateTime
  amount        Float
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([propertyId])
  @@index([unitId])
}

model Tenant {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  leaseStart  DateTime?
  leaseEnd    DateTime?
  deposit     Float     @default(0)
  // Day of the month rent is due, 1-31 (clamped to the month's last day).
  // Drives how many days late an unpaid month is.
  dueDay      Int       @default(1)
  active      Boolean   @default(true)
  note        String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([propertyId])
  @@index([unitId])
}

model Transaction {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  type        String
  date        DateTime
  amount      Float
  detail      String?
  note        String?
  category    String?
  createdAt   DateTime @default(now())

  attachments        Attachment[]
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([unitId])
  @@index([recurringExpenseId])
}

// A template for a bill that repeats (mortgage, insurance, HOA). It never
// posts anything on its own — the dashboard surfaces it as due, and logging
// it is a one-click action that creates a normal Transaction tagged back to
// this template, so nothing lands in the ledger without a person seeing it.
model RecurringExpense {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  category    String
  detail      String?
  note        String?
  amount      Float
  frequency   String // "monthly" | "yearly"
  day         Int // day of month, 1-31 (clamped to the month's last day)
  month       Int? // 1-12, only used when frequency = "yearly"
  active      Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  transactions Transaction[]

  @@index([propertyId])
  @@index([unitId])
}

model Attachment {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  url           String
  pathname      String
  filename      String
  contentType   String
  size          Int
  uploadedById  String?
  uploadedBy    User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}
