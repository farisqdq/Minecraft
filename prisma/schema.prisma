generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations go straight to the database, not through the pooler the app
  // uses: a pooler in transaction mode can't run a migration's DDL safely.
  directUrl = env("DATABASE_POSTGRES_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  /// Stamped into every session token. Bumping it signs this account out
  /// everywhere at once — "sign out everywhere", a password change — because
  /// every request compares the token's copy against this one.
  sessionVersion    Int       @default(0)
  /// Two-factor: the authenticator app's secret, encrypted with a key derived
  /// from NEXTAUTH_SECRET so a copy of the database alone can't generate codes.
  totpSecret        String?
  /// The same, while being set up and not yet confirmed with a first code.
  totpPendingSecret String?
  totpEnabledAt     DateTime?
  /// The last 30-second window a code was accepted for, so a code seen over
  /// someone's shoulder can't be used a second time.
  totpLastStep      Int?
  /// SHA-256 of each unused one-time backup code.
  recoveryCodes     String[]  @default([])
  /// Runs the site: sees every account and LLC, and can change them. Granted
  /// by another admin, or by being on ADMIN_EMAILS (see lib/admin.ts).
  isAdmin           Boolean   @default(false)

  memberships         CompanyMember[]
  invitesSent         Invite[]            @relation("InviteSender")
  createdProperties   Property[]
  createdTransactions Transaction[]
  uploadedAttachments Attachment[]
  createdRecurring    RecurringExpense[]
  createdTenants      Tenant[]
  RentChange          RentChange[]
  tenantInvitesSent   TenantInvite[]      @relation("TenantInviteSender")
  requestUpdates      MaintenanceUpdate[]
  requestPhotos       MaintenancePhoto[]
  noticesSent         TenantNotice[]
  chargesRaised       TenantCharge[]
  chargeRules         TenantChargeRule[]
  vendorsAdded        Vendor[]
  documentsUploaded   Document[]
  loansAdded          Loan[]
  loanPayments        LoanPayment[]
  moveOuts            MoveOut[]
  assetsAdded         DepreciableAsset[]
  adminActions        AdminLog[]
  passwordResets      PasswordReset[]
  pushSubscriptions   PushSubscription[]
}

model Company {
  id           String   @id @default(cuid())
  name         String
  // What tenants of this LLC's properties see under "Who to contact" — a
  // dispatch line or an office inbox, never a person's own number. Both are
  // optional and the portal shows nothing at all until one is filled in.
  contactPhone String?
  contactEmail String?
  createdAt    DateTime @default(now())

  members       CompanyMember[]
  properties    Property[]
  invites       Invite[]
  vendors       Vendor[]
  documents     Document[]
  reminders     ReminderSettings?
  sent          ReminderSent[]
  /// The company-wide late-fee policy (a15); absent means no automatic late fees.
  lateFeePolicy LateFeePolicy?
}

model CompanyMember {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String?
  role        String    @default("member")
  token       String    @unique
  invitedById String?
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  @@index([companyId])
  @@index([email])
}

model Property {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  name        String
  address     String?
  monthlyRent Float     @default(0)
  vacant      Boolean   @default(false)
  /// When it went empty — or rather, when rent stopped coming in. Null when
  /// occupied, and on places marked vacant before this was recorded.
  vacantSince DateTime?
  createdAt   DateTime  @default(now())

  units             Unit[]
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]
  tenants           Tenant[]
  rentChanges       RentChange[]
  requests          MaintenanceRequest[]
  documents         Document[]
  loans             Loan[]
  assets            DepreciableAsset[]

  @@index([companyId])
}

// A single rental unit inside a property. Optional: most properties have
// none and are tracked directly, this only kicks in for a duplex/triplex/
// building where each unit needs its own rent target and tenant.
model Unit {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name        String
  monthlyRent Float     @default(0)
  vacant      Boolean   @default(false)
  /// As on Property.
  vacantSince DateTime?
  createdAt   DateTime  @default(now())

  transactions      Transaction[]
  recurringExpenses RecurringExpense[]
  tenants           Tenant[]
  rentChanges       RentChange[]
  requests          MaintenanceRequest[]

  @@index([propertyId])
}

// Who is renting a place, and on what terms. Lease details live here rather
// than in a separate Lease model because a small landlord thinks in terms of
// "who's in the house right now" — a tenant who moves out is kept with
// active = false so their history and their old ledger entries still make
// sense, and the next tenant is a new row.
// What a place rented for, and from when. Without this, raising the rent
// would re-judge every month already on the books against the new figure —
// a year of correctly paid rent would suddenly read as short. A row is
// written whenever the rent changes; months before the earliest row fall
// back to whatever the property or unit currently says.
model RentChange {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId        String?
  unit          Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // Always the first day of the month the amount takes effect.
  effectiveFrom DateTime
  amount        Float
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([propertyId])
  @@index([unitId])
}

model Tenant {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  leaseStart  DateTime?
  leaseEnd    DateTime?
  deposit     Float     @default(0)
  // Day of the month rent is due, 1-31 (clamped to the month's last day).
  // Drives how many days late an unpaid month is.
  dueDay      Int       @default(1)
  active      Boolean   @default(true)
  note        String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  account   TenantAccount?
  invites   TenantInvite[]
  requests  MaintenanceRequest[]
  notices   TenantNotice[]
  charges   TenantCharge[]
  rules     TenantChargeRule[]
  documents Document[]
  moveOut   MoveOut?

  // What they owed on the day you started keeping books here, and the first
  // month to charge rent for. Without these, a lease that began in 2023 and a
  // ledger that begins in 2025 would produce two years of invented arrears —
  // the app would tell you a tenant who has never missed a month owes forty
  // thousand dollars. Null means "start at the first month they actually paid
  // something", which is the safe reading of no information.
  openingBalance Float   @default(0)
  balanceFrom    String?

  /// Whether automatic reminders (rent due, lease ending, repair updates)
  /// may reach this tenant by each channel. Both on by default; the tenant
  /// can switch either off from the portal, the landlord can switch email
  /// off from the tenant card. Push also needs a device they've enabled.
  emailReminders Boolean @default(true)
  pushReminders  Boolean @default(true)

  /// Which late-fee rules bill this tenant (a15): "default" follows the
  /// company's LateFeePolicy, "custom" uses only this tenant's own late
  /// rules, "off" charges no late fees at all. Monthly rules are unaffected.
  lateFeeMode String @default("default")

  @@index([propertyId])
  @@index([unitId])
}

// A tenant's own login for the portal, deliberately separate from User.
//
// User is the landlord side: a User belongs to companies, and every route in
// the app reaches data by walking user -> company -> property. A tenant must
// never touch that walk, so they get their own table, their own credentials
// provider and their own "kind" on the session token rather than a role
// column on User — one missed role check on a shared table is the whole
// ledger, and there is no way to miss a check on a table the landlord
// queries never join to.
//
// The row hangs off a Tenant, which is what carries the property and unit, so
// deleting a tenant takes their login with it.
model TenantAccount {
  id             String    @id @default(cuid())
  tenantId       String    @unique
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String    @unique
  passwordHash   String
  createdAt      DateTime  @default(now())
  lastLoginAt    DateTime?
  /// As on User: bump it and every session for this login ends.
  sessionVersion Int       @default(0)

  pushSubscriptions PushSubscription[]
}

// The only way a TenantAccount comes into existence. The landlord issues a
// code for one named tenant; redeeming it binds the new account to that
// tenant and nothing else. Without this there would be a public signup form
// where a stranger picks which unit they live in.
model TenantInvite {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String    @unique
  invitedById String?
  invitedBy   User?     @relation("TenantInviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  @@index([tenantId])
}

model Transaction {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  type        String
  date        DateTime
  amount      Float
  detail      String?
  note        String?
  category    String?
  createdAt   DateTime @default(now())

  attachments        Attachment[]
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  // Who was paid, when an expense went to someone in the vendor book. It is
  // what makes "what have I spent with this plumber this year?" a lookup.
  vendorId           String?
  vendor             Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  // Set on the interest and escrow entries a mortgage payment wrote, so the
  // ledger can say where they came from and refuse to let one half of a
  // payment be changed without the other. SetNull, not Cascade: deleting a
  // loan record must never delete interest that was really paid — undoing
  // a payment removes its entries explicitly.
  loanPaymentId      String?
  loanPayment        LoanPayment?      @relation(fields: [loanPaymentId], references: [id], onDelete: SetNull)
  // Set on the income a move-out kept from a security deposit, so undoing the
  // move-out takes it back out and the ledger can't delete it on its own.
  moveOutId          String?
  moveOut            MoveOut?          @relation(fields: [moveOutId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([unitId])
  @@index([recurringExpenseId])
  @@index([vendorId])
  @@index([loanPaymentId])
  @@index([moveOutId])
}

// The end of a tenancy, and what happened to the security deposit.
//
// A deposit is not income while it's held — it's the tenant's money. At
// move-out it splits three ways: some pays rent they still owe, some covers
// damage, and the rest goes back to them, usually within a deadline set by
// state law, with an itemized list of what was kept. Money kept becomes rental
// income on the day it's kept (Transaction.moveOutId); money returned never
// touches the ledger at all.
//
// It also records the last month rent is owed for. Before this, a tenant
// marked moved out kept being charged to the end of their lease, so leaving
// three months early read as three months of arrears.
model MoveOut {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  movedOutOn        DateTime
  /// YYYY-MM: the last month rent is charged for.
  lastRentMonth     String
  /// The deposit held on the day they left, frozen so later edits can't change the statement.
  deposit           Float
  /// What's owed back: the deposit less deductions, never below zero.
  refund            Float
  /// The deadline for returning it and sending the itemized list.
  returnBy          DateTime?
  returnedOn        DateTime?
  /// How it went back: "Check #1042", "Zelle".
  returnNote        String?
  /// Where to send it — the one thing a landlord always has to chase.
  forwardingAddress String?
  /// Whether recording this move-out marked their place vacant, so undoing
  /// it can put that back — and only that.
  madeVacant        Boolean   @default(false)
  createdById       String?
  createdBy         User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())

  deductions   MoveOutDeduction[]
  transactions Transaction[]
  charges      TenantCharge[]
}

// One line of the itemized list: rent the deposit paid, or a charge it covered.
model MoveOutDeduction {
  id        String  @id @default(cuid())
  moveOutId String
  moveOut   MoveOut @relation(fields: [moveOutId], references: [id], onDelete: Cascade)
  /// "rent" pays down what they owe; "charge" is damage, cleaning or the like.
  kind      String
  label     String
  amount    Float

  @@index([moveOutId])
}

// A mortgage, stored as the figures printed on its monthly statement.
//
// It exists because a mortgage payment is three kinds of money under one
// number: interest (an expense), escrow (property tax and insurance — also
// expenses, on other lines), and principal (not an expense: it's equity).
// Logged as one recurring bill, the whole payment landed under "Mortgage
// Interest", understating profit and overstating the one deduction an
// accountant checks against the lender's Form 1098. See lib/loans.ts.
//
// The balance is "as of" a month rather than an original amount and term,
// because most loans began long before the books did, and the statement on
// the kitchen table has today's balance on it, not the 2019 one.
model Loan {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lender          String
  /// Principal owed going into `balanceAsOf`, before that month's payment.
  balance         Float
  /// YYYY-MM: the first payment tracked here.
  balanceAsOf     String
  /// Annual rate as a percentage: 6.25 means 6.25%.
  rate            Float
  /// Monthly principal and interest, without escrow.
  payment         Float
  escrowTax       Float    @default(0)
  escrowInsurance Float    @default(0)
  dueDay          Int      @default(1)
  /// Off once it's paid off or refinanced; kept for its history.
  active          Boolean  @default(true)
  note            String?
  createdById     String?
  createdBy       User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  payments LoanPayment[]

  @@index([propertyId])
}

// One month's payment on a loan, split. The interest and escrow are also
// ordinary ledger entries (Transaction.loanPaymentId); the principal lives
// only here, because it isn't an expense and must not reach the profit line.
model LoanPayment {
  id          String   @id @default(cuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  /// The YYYY-MM this payment was for, which may not be the month it was made.
  month       String
  date        DateTime
  principal   Float
  interest    Float
  /// Tax plus insurance escrow, for the record; the ledger has them apart.
  escrow      Float    @default(0)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  transactions Transaction[]

  /// One payment per loan per month, enforced by the database: "Log it"
  /// pressed twice, or on two phones at once, must not pay a mortgage twice.
  @@unique([loanId, month])
}

// Someone you call to fix things: a plumber, an HVAC company, the person who
// does the parking lot. Kept per LLC, like everything else, so a teammate on
// one company never sees another company's contractors.
model Vendor {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  // One of lib/vendors.ts TRADES, so the book can be grouped and a repair's
  // category can suggest the right person.
  trade       String   @default("General")
  phone       String?
  email       String?
  note        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  repairs      MaintenanceRequest[]
  transactions Transaction[]
  documents    Document[]

  @@index([companyId])
}

// A file worth keeping with its expiry date: a lease, a commercial tenant's
// certificate of insurance, a business licence, an inspection, a vendor's
// W-9. The expiry is the point — an insurance certificate that lapsed in
// March is only noticed after the claim, unless something says so first.
//
// Hangs off one LLC, and optionally a property, a tenant or a vendor inside
// it, so the property page, the tenant card and the vendor book can each
// show what belongs to them.
model Document {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  propertyId   String?
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  vendorId     String?
  vendor       Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  title        String
  /// One of lib/documents.ts KINDS.
  kind         String    @default("Other")
  url          String
  pathname     String
  filename     String
  contentType  String
  size         Int
  /// The day it stops being valid, if it ever does. Stored as a UTC midnight.
  expiresOn    DateTime?
  note         String?
  /// Tenant documents only: whether it shows on that tenant's portal. Off
  /// unless someone turns it on — a lease is theirs to read, the landlord's
  /// notes on their application are not.
  shared       Boolean   @default(false)
  uploadedById String?
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([companyId])
  @@index([propertyId])
  @@index([tenantId])
  @@index([vendorId])
  @@index([expiresOn])
}

// A template for a bill that repeats (mortgage, insurance, HOA). It never
// posts anything on its own — the dashboard surfaces it as due, and logging
// it is a one-click action that creates a normal Transaction tagged back to
// this template, so nothing lands in the ledger without a person seeing it.
model RecurringExpense {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  category    String
  detail      String?
  note        String?
  amount      Float
  frequency   String // "monthly" | "yearly"
  day         Int // day of month, 1-31 (clamped to the month's last day)
  month       Int? // 1-12, only used when frequency = "yearly"
  active      Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  transactions Transaction[]

  @@index([propertyId])
  @@index([unitId])
}

model Attachment {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  url           String
  pathname      String
  filename      String
  contentType   String
  size          Int
  uploadedById  String?
  uploadedBy    User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

// Something the tenant needs fixed.
//
// The status is the whole point of the thing: a tenant who can see that you
// have read it and called someone stops ringing every morning, and a landlord
// with a queue stops finding out about the leak when the ceiling comes down.
model MaintenanceRequest {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId     String?
  unit       Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  // Who reported it. Kept even after they move out, so the history of a place
  // survives its tenants.
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  title         String
  detail        String
  category      String
  // "normal" | "urgent" — an emergency is a phone call, not a web form, and
  // the portal says so rather than offering a third level nobody agrees on.
  urgency       String    @default("normal")
  // "open" | "seen" | "scheduled" | "done" | "declined"
  status        String    @default("open")
  // Where the tenant says the problem is, in their words: "kitchen sink".
  place         String?
  // Set when the status first leaves "open", so response time is measurable.
  seenAt        DateTime?
  resolvedAt    DateTime?
  // Filled in when a finished repair is logged into the ledger, so the same
  // repair can't be booked as an expense twice.
  transactionId String?
  // Who's fixing it. Landlord-only: the portal never sees this, because a
  // tenant ringing the plumber directly is how a $90 visit becomes $400.
  vendorId      String?
  vendor        Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updates MaintenanceUpdate[]
  photos  MaintenancePhoto[]

  @@index([propertyId])
  @@index([unitId])
  @@index([tenantId])
  @@index([status])
}

// One entry in the back-and-forth: a note from either side, or the record of
// a status change. Both live in one table so the tenant reads a single
// timeline instead of a comment list beside a history list.
model MaintenanceUpdate {
  id             String             @id @default(cuid())
  requestId      String
  request        MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // Exactly one of these is set, and which one decides how the row is shown
  // and who is allowed to have written it.
  authorUserId   String?
  authorUser     User?              @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorTenantId String?
  // The name to print, frozen at the time of writing so a deleted account
  // doesn't turn the thread into a row of blanks.
  authorName     String
  body           String
  // Set instead of a body when this row is a status change.
  statusTo       String?
  createdAt      DateTime           @default(now())

  @@index([requestId])
}

// A photo of the problem. Separate from Attachment, which hangs off a
// Transaction — loosening that model's foreign key to serve two masters is
// how a proof file ends up attached to nothing.
model MaintenancePhoto {
  id           String             @id @default(cuid())
  requestId    String
  request      MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  url          String
  pathname     String
  filename     String
  contentType  String
  size         Int
  // Null when the tenant uploaded it; tenants are not Users.
  uploadedById String?
  uploadedBy   User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())

  @@index([requestId])
}

// Failed sign-in counts, so a password can't be guessed by brute force.
//
// It lives in the database rather than in memory because the app runs on
// serverless functions — memory is per-instance and gone between requests.
// One row per key; keys are "user:<email>", "tenant:<email>" and "ip:<addr>".
// The email keys stop a single account being hammered; the ip key stops one
// machine trying a thousand accounts. Rows are only ever written on failure
// and cleared on success, and stale ones are swept on the next success.
model LoginThrottle {
  key         String    @id
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// A note the landlord puts in front of a tenant: nearly always "your rent is
// short", occasionally something else.
//
// It exists as a row rather than as a text message and nothing else because
// the record is half the point — you need to know you already chased someone
// on Tuesday so you don't do it again on Wednesday, and if it ever goes to
// eviction, when you asked and whether they read it is the question.
//
// Sending one does not move any money. It is a message about the ledger, not
// an entry in it.
model TenantNotice {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // "rent" for a rent chase, "note" for anything else.
  kind      String    @default("rent")
  // The month being chased, as YYYY-MM, and what was outstanding when the
  // notice went out. Frozen at send time: a later payment shouldn't rewrite
  // what you told them they owed.
  month     String?
  amount    Float?
  body      String
  sentById  String?
  sentBy    User?     @relation(fields: [sentById], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([tenantId])
}

// Anything a tenant owes that isn't the scheduled rent: a late fee, the lot
// fee billed alongside rent, a repair they're liable for — or a credit going
// the other way.
//
// Rent itself is deliberately NOT stored here. It's derived from the rent
// history, which already knows what each place cost in each month and already
// handles a raise mid-lease. Writing rent rows as well would mean two sources
// for the same number and a backfill for every tenant on the books.
model TenantCharge {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // "fee" adds to what they owe; "credit" takes off it.
  kind       String            @default("fee")
  /// The YYYY-MM this belongs to, so it lands in the right row of a statement.
  month      String
  label      String
  /// Always positive. Which direction it moves is `kind`, so a sign error
  /// can't silently turn a charge into a credit.
  amount     Float
  raisedById String?
  raisedBy   User?             @relation(fields: [raisedById], references: [id], onDelete: SetNull)
  /// Set when a standing rule produced this rather than a person typing it.
  /// Only ever a label on where it came from: deleting the charge deletes
  /// it, and what stops a rule writing it again is TenantRuleRun, not this.
  ruleId     String?
  rule       TenantChargeRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  /// Set on a damage or cleaning charge a move-out raised against the deposit.
  moveOutId  String?
  moveOut    MoveOut?          @relation(fields: [moveOutId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())

  @@index([tenantId])
}

// A standing rule about what a tenant owes beyond rent: something billed
// every month alongside it, or a fee that only exists because rent is late.
//
// The rule is a template. What it produces is an ordinary TenantCharge, so
// every dollar is a row the landlord can see, waive and explain — not a
// number that exists only inside a calculation.
model TenantChargeRule {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// "monthly" rides along with rent; "late" applies only to rent still owed.
  kind        String   @default("monthly")
  label       String
  /// Dollars, or a percentage of that month's rent when `percent` is set.
  amount      Float
  percent     Boolean  @default(false)
  /// "late" only: days after the rent due day before the fee applies.
  graceDays   Int      @default(5)
  /// Bounds, so a rule can be stopped without deleting the history it made.
  startMonth  String?
  endMonth    String?
  active      Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  /// "late" only (a15): dollars added for every further day the month stays
  /// owed after the first late day. 0 means the fee is one-off.
  dailyAmount Float    @default(0)
  /// "late" only (a15): ceiling on everything this rule charges for one
  /// month, as a percentage of that month's rent. 0 means no ceiling.
  capPercent  Float    @default(0)
  /// Set on the one rule per tenant that lib/statements.ts keeps in step
  /// with the company's LateFeePolicy. Never edited or deleted by hand: its
  /// runs are what stop the policy billing a day twice.
  fromPolicy  Boolean  @default(false)

  charges TenantCharge[]
  runs    TenantRuleRun[]

  @@index([tenantId])
}

// One row per month a rule has been applied for.
//
// This is deliberately not the charge itself. Deleting a charge has to mean
// deleting it — the money is reversed and the row is gone — and if the rule's
// memory lived on the charge, the next page load would write it straight back
// and the delete would look broken. So the rule remembers here, the charge is
// an ordinary row, and removing one never brings it back.
model TenantRuleRun {
  id     String           @id @default(cuid())
  ruleId String
  rule   TenantChargeRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  /// The YYYY-MM the rule was applied for.
  month  String
  /// What it charged, kept for the record even after the charge is deleted.
  amount Float
  ranAt  DateTime         @default(now())
  /// The YYYY-MM-DD a per-day late fee was for (a15), or "" for the
  /// one-time fee of the month — so a daily rule gets one run per day.
  day    String           @default("")

  /// Applied at most once per month (and per day, for a daily fee),
  /// enforced by the database rather than by remembering to check — two
  /// requests landing together is the ordinary case on a dashboard and must
  /// not bill a tenant twice.
  @@unique([ruleId, month, day])
}

// Something on a property that's depreciated rather than deducted at once:
// the building itself, or an improvement to it (a roof, a furnace, a
// remodel). See lib/depreciation.ts — this is the Schedule E line 18
// deduction, which never appears in a ledger because no money moves.
model DepreciableAsset {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  /// "building" or "improvement".
  kind        String   @default("building")
  label       String
  /// "residential" (27.5 years) or "commercial" (39).
  cls         String   @default("residential")
  /// The depreciable cost, in dollars — never including land.
  basis       Float
  /// YYYY-MM it was first ready and available to rent.
  inService   String
  note        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([propertyId])
}

// What an admin did to whom. An admin can delete any account and rewrite any
// team, so every such action is written down: who, what, to which account
// or LLC, when. The emails are frozen text, because the account they name
// may be the one that was deleted.
model AdminLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  adminEmail String
  /// e.g. "account.delete", "company.member.add".
  action     String
  target     String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// A one-time link to set a new password, for a landlord who has forgotten
// theirs. Only the hash of the token is kept — the link itself is the
// secret, and a copy of the database must not be enough to use one. It
// lives an hour, works once, and issuing a new one retires the old.
model PasswordReset {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  /// "self" when asked for on the sign-in page, otherwise the admin's email.
  issuedBy       String    @default("self")
  /// The account's sessionVersion when issued. A password change or a
  /// sign-out-everywhere bumps that, and a link from before it is dead.
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([userId])
}

/// How and when a company's automatic reminders go out. One row per company,
/// made the first time someone opens the settings; a company without one is
/// off. Channels are per reminder type: email, push, and room for a text
/// channel later. Days lists are "60,30" strings, parsed by lib/reminders.
model ReminderSettings {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// The master switch. Nothing goes out for a company until it's on.
  enabled   Boolean @default(false)

  rentDueOn    Boolean @default(true)
  rentDueDays  Int     @default(3)
  rentDueEmail Boolean @default(true)
  rentDuePush  Boolean @default(true)

  rentLateOn        Boolean @default(true)
  /// Used when the tenant has no late-fee rule saying otherwise.
  rentLateGraceDays Int     @default(5)
  rentLateEmail     Boolean @default(true)
  rentLatePush      Boolean @default(true)

  leaseEndOn     Boolean @default(true)
  leaseEndDays   String  @default("60,30")
  /// Whether the tenant hears about it too, not only the landlord.
  leaseEndTenant Boolean @default(false)
  leaseEndEmail  Boolean @default(true)
  leaseEndPush   Boolean @default(true)

  docExpiryOn    Boolean @default(true)
  docExpiryDays  String  @default("30,7")
  docExpiryEmail Boolean @default(true)
  docExpiryPush  Boolean @default(true)

  maintenanceOn    Boolean @default(true)
  maintenanceEmail Boolean @default(true)
  maintenancePush  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Every reminder that went out, or was tried. The unique key is what makes
/// the daily run safe to repeat: a second run finds the row and stops, so a
/// tenant is never told twice that rent is due on the 1st.
model ReminderSent {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// "rent-due" | "rent-late" | "lease-end" | "doc-expiry" | "maintenance" | "message" | "test"
  kind      String
  /// What was being reminded about: "rent-due:<tenantId>:<month>" and the like.
  key       String
  /// "email" | "push" (a text channel would be "sms").
  channel   String
  /// The address, or "user:<id>" / "tenant:<accountId>" for push.
  to        String
  /// "sending" while in flight, then "sent" | "failed" | "skipped".
  status    String   @default("sending")
  detail    String?
  createdAt DateTime @default(now())

  @@unique([key, channel, to])
  @@index([companyId, createdAt])
}

/// A phone or browser that asked for push notifications. One per device, for
/// a landlord (userId) or a tenant login (tenantAccountId). Dropped when the
/// push service says the endpoint is gone.
model PushSubscription {
  id              String         @id @default(cuid())
  userId          String?
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantAccountId String?
  tenantAccount   TenantAccount? @relation(fields: [tenantAccountId], references: [id], onDelete: Cascade)
  endpoint        String         @unique
  p256dh          String
  auth            String
  userAgent       String?
  createdAt       DateTime       @default(now())
  lastUsedAt      DateTime?

  @@index([userId])
  @@index([tenantAccountId])
}

/// ---- Late fee policy (a15) ----

/// What every tenant of the company is charged when rent is late, unless
/// their own lateFeeMode says otherwise. One row per company, made the first
/// time an owner saves the settings; a company without one charges nothing.
/// It is not a rule row itself: lib/statements.ts materialises it as one
/// `fromPolicy` TenantChargeRule per tenant, so every fee it produces is an
/// ordinary TenantCharge with a TenantRuleRun behind it.
model LateFeePolicy {
  id          String   @id @default(cuid())
  companyId   String   @unique
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enabled     Boolean  @default(false)
  /// Days after the due day before the first fee.
  graceDays   Int      @default(5)
  /// One-time fee on the first late day, as a percentage of that month's rent.
  percent     Float    @default(7)
  /// Dollars for each further day the month stays owed.
  dailyAmount Float    @default(5)
  /// Ceiling on the month's late fees, as a percentage of that month's rent; 0 = none.
  capPercent  Float    @default(12)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
