generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  memberships         CompanyMember[]
  invitesSent         Invite[]           @relation("InviteSender")
  createdProperties   Property[]
  createdTransactions Transaction[]
  uploadedAttachments Attachment[]
  createdRecurring    RecurringExpense[]
  createdTenants      Tenant[]
  RentChange          RentChange[]
  tenantInvitesSent   TenantInvite[]     @relation("TenantInviteSender")
  requestUpdates      MaintenanceUpdate[]
  requestPhotos       MaintenancePhoto[]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  // What tenants of this LLC's properties see under "Who to contact" — a
  // dispatch line or an office inbox, never a person's own number. Both are
  // optional and the portal shows nothing at all until one is filled in.
  contactPhone String?
  contactEmail String?
  createdAt DateTime @default(now())

  members    CompanyMember[]
  properties Property[]
  invites    Invite[]
}

model CompanyMember {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String?
  role        String    @default("member")
  token       String    @unique
  invitedById String?
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  @@index([companyId])
  @@index([email])
}

model Property {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  name        String
  address     String?
  monthlyRent Float    @default(0)
  vacant      Boolean  @default(false)
  createdAt   DateTime @default(now())

  units             Unit[]
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]
  tenants           Tenant[]
  rentChanges       RentChange[]
  requests          MaintenanceRequest[]

  @@index([companyId])
}

// A single rental unit inside a property. Optional: most properties have
// none and are tracked directly, this only kicks in for a duplex/triplex/
// building where each unit needs its own rent target and tenant.
model Unit {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name        String
  monthlyRent Float    @default(0)
  vacant      Boolean  @default(false)
  createdAt   DateTime @default(now())

  transactions      Transaction[]
  recurringExpenses RecurringExpense[]
  tenants           Tenant[]
  rentChanges       RentChange[]
  requests          MaintenanceRequest[]

  @@index([propertyId])
}

// Who is renting a place, and on what terms. Lease details live here rather
// than in a separate Lease model because a small landlord thinks in terms of
// "who's in the house right now" — a tenant who moves out is kept with
// active = false so their history and their old ledger entries still make
// sense, and the next tenant is a new row.
// What a place rented for, and from when. Without this, raising the rent
// would re-judge every month already on the books against the new figure —
// a year of correctly paid rent would suddenly read as short. A row is
// written whenever the rent changes; months before the earliest row fall
// back to whatever the property or unit currently says.
model RentChange {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId        String?
  unit          Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  // Always the first day of the month the amount takes effect.
  effectiveFrom DateTime
  amount        Float
  createdById   String?
  createdBy     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([propertyId])
  @@index([unitId])
}

model Tenant {
  id          String    @id @default(cuid())
  propertyId  String
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  leaseStart  DateTime?
  leaseEnd    DateTime?
  deposit     Float     @default(0)
  // Day of the month rent is due, 1-31 (clamped to the month's last day).
  // Drives how many days late an unpaid month is.
  dueDay      Int       @default(1)
  active      Boolean   @default(true)
  note        String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  account  TenantAccount?
  invites  TenantInvite[]
  requests MaintenanceRequest[]

  @@index([propertyId])
  @@index([unitId])
}

// A tenant's own login for the portal, deliberately separate from User.
//
// User is the landlord side: a User belongs to companies, and every route in
// the app reaches data by walking user -> company -> property. A tenant must
// never touch that walk, so they get their own table, their own credentials
// provider and their own "kind" on the session token rather than a role
// column on User — one missed role check on a shared table is the whole
// ledger, and there is no way to miss a check on a table the landlord
// queries never join to.
//
// The row hangs off a Tenant, which is what carries the property and unit, so
// deleting a tenant takes their login with it.
model TenantAccount {
  id           String    @id @default(cuid())
  tenantId     String    @unique
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

// The only way a TenantAccount comes into existence. The landlord issues a
// code for one named tenant; redeeming it binds the new account to that
// tenant and nothing else. Without this there would be a public signup form
// where a stranger picks which unit they live in.
model TenantInvite {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String    @unique
  invitedById String?
  invitedBy   User?     @relation("TenantInviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?

  @@index([tenantId])
}

model Transaction {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  type        String
  date        DateTime
  amount      Float
  detail      String?
  note        String?
  category    String?
  createdAt   DateTime @default(now())

  attachments        Attachment[]
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([unitId])
  @@index([recurringExpenseId])
}

// A template for a bill that repeats (mortgage, insurance, HOA). It never
// posts anything on its own — the dashboard surfaces it as due, and logging
// it is a one-click action that creates a normal Transaction tagged back to
// this template, so nothing lands in the ledger without a person seeing it.
model RecurringExpense {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  category    String
  detail      String?
  note        String?
  amount      Float
  frequency   String // "monthly" | "yearly"
  day         Int // day of month, 1-31 (clamped to the month's last day)
  month       Int? // 1-12, only used when frequency = "yearly"
  active      Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  transactions Transaction[]

  @@index([propertyId])
  @@index([unitId])
}

model Attachment {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  url           String
  pathname      String
  filename      String
  contentType   String
  size          Int
  uploadedById  String?
  uploadedBy    User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

// Something the tenant needs fixed.
//
// The status is the whole point of the thing: a tenant who can see that you
// have read it and called someone stops ringing every morning, and a landlord
// with a queue stops finding out about the leak when the ceiling comes down.
model MaintenanceRequest {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitId     String?
  unit       Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  // Who reported it. Kept even after they move out, so the history of a place
  // survives its tenants.
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  title       String
  detail      String
  category    String
  // "normal" | "urgent" — an emergency is a phone call, not a web form, and
  // the portal says so rather than offering a third level nobody agrees on.
  urgency     String    @default("normal")
  // "open" | "seen" | "scheduled" | "done" | "declined"
  status      String    @default("open")
  // Where the tenant says the problem is, in their words: "kitchen sink".
  place       String?
  // Set when the status first leaves "open", so response time is measurable.
  seenAt      DateTime?
  resolvedAt  DateTime?
  // Filled in when a finished repair is logged into the ledger, so the same
  // repair can't be booked as an expense twice.
  transactionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updates MaintenanceUpdate[]
  photos  MaintenancePhoto[]

  @@index([propertyId])
  @@index([unitId])
  @@index([tenantId])
  @@index([status])
}

// One entry in the back-and-forth: a note from either side, or the record of
// a status change. Both live in one table so the tenant reads a single
// timeline instead of a comment list beside a history list.
model MaintenanceUpdate {
  id        String             @id @default(cuid())
  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // Exactly one of these is set, and which one decides how the row is shown
  // and who is allowed to have written it.
  authorUserId   String?
  authorUser     User?         @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  authorTenantId String?
  // The name to print, frozen at the time of writing so a deleted account
  // doesn't turn the thread into a row of blanks.
  authorName String
  body       String
  // Set instead of a body when this row is a status change.
  statusTo   String?
  createdAt  DateTime @default(now())

  @@index([requestId])
}

// A photo of the problem. Separate from Attachment, which hangs off a
// Transaction — loosening that model's foreign key to serve two masters is
// how a proof file ends up attached to nothing.
model MaintenancePhoto {
  id        String             @id @default(cuid())
  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  url         String
  pathname    String
  filename    String
  contentType String
  size        Int
  // Null when the tenant uploaded it; tenants are not Users.
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([requestId])
}
